    "max_rounds": 3,
    "base_branch": "master",
    "merge_method": "merge",
    "labels": {
        "queue": "factory",
        "needs_info": "factory:needs-info",
        "needs_human": "factory:needs-human"
    },
    "routing": {
        "low": { "code": "low" },
        "medium": { "code": "medium" },
        "high": { "code": "high" }
