{
    "concurrency": 3,
    "max_rounds": 3,
    "base_branch": "master",
    "merge_method": "merge",
    "labels": {
        "queue": "factory",
        "needs_info": "factory:needs-info",
        "needs_human": "factory:needs-human"
    },
    "routing": {
        "low": { "code": "reviewer-code-low" },
        "medium": { "code": "reviewer-code" },
        "high": { "code": "reviewer-code-high" }
    },
    "surface_reviewers": {
        "ui": { "ux": "reviewer-ux", "ui": "reviewer-ui" },
        "security": { "security": "reviewer-security" }
    },
    "protected_paths": [
        "factory/checks.py",
        "factory/config.json",
        "factory/bin/*",
        ".codex/agents/*",
        ".agents/skills/factory/*"
    ],
    "ports": { "base": 5100, "step": 10 },
    "prices_usd_per_mtok": {
        "gpt-6.2-astra": { "input": 8, "cached_input": 0.4, "cache_write_30m": 10, "output": 40 },
        "gpt-6.2-sol": { "input": 2, "cached_input": 0.1, "cache_write_30m": 2.5, "output": 10 },
        "gpt-6.1-terra": { "input": 1, "cached_input": 0.05, "cache_write_30m": 1.25, "output": 5 }
    }
}
